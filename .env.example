# Notion Credentials
NOTION_API_KEY=ntn_your_notion_integration_token_here
# Parent Page ID where database will be created
NOTION_PAGE_ID=your_notion_parent_page_id
# Optional: Specify exact Database ID once created, or leave empty to auto-detect/create
NOTION_DATABASE_ID=

# Strava Credentials
# Obtain from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
# Generated via setup_strava_auth.py script
STRAVA_REFRESH_TOKEN=your_strava_refresh_token
